# NVIDIA_API_KEY: Required for NVIDIA NIM GLM analysis.
# Set this in your local .env file or deployment secret manager.
NVIDIA_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Credentials:
# Connects to your PostgreSQL database where Telegram calls are stored.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Solana RPC Configuration (Optional):
# Defaults to public https://api.mainnet-beta.solana.com or Helius / QuickNode
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Telegram Signal Alerts (Optional):
# Server-side bot alerts for published signals
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
